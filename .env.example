# Shared configuration for every app in the repo. Copy to .env and fill in.
# Loaded by apps/api/dev-run.mjs and apps/api/migrate.mjs alongside
# apps/api/.env.dev (the app-specific file wins; real env vars win over both).
#
# REPLACE EVERY VALUE BELOW. These are placeholders, not defaults — the commands
# reject them rather than trying to reach a host that does not exist.

# ── Database (ADR 0013) ──────────────────────────────────────────────────────
# Postgres is required; there is no embedded fallback. Migrate before starting:
#   pnpm db:migrate && pnpm dev
#
# Runtime connection. On Neon this is the POOLED endpoint (…-pooler.…), and it
# should use the least-privileged app role rather than the database owner:
#   pnpm db:migrate --create-app-role
DATABASE_URL=postgresql://cixtech_app:PASSWORD@ep-REPLACE-pooler.region.aws.neon.tech/neondb?sslmode=require

# Non-pooled endpoint, used for DDL/migrations only. Keep the OWNER credentials
# here — migrations need privileges the app role deliberately does not have.
# Optional (falls back to DATABASE_URL), but the app role cannot run DDL.
DIRECT_DATABASE_URL=postgresql://OWNER:PASSWORD@ep-REPLACE.region.aws.neon.tech/neondb?sslmode=require

# TLS is verified for any non-local host. This one stays commented out on
# purpose — it is not a default, it is an override that WEAKENS verification.
# Uncomment only for a self-signed server, and never in production.
# CIXTECH_DB_SSL=no-verify        # disable | no-verify | require

# Name for the provisioned application role (default: cixtech_app).
CIXTECH_APP_ROLE=cixtech_app
TEST_API_KEY=REPLACE_ME

# ── Network selection (§16.5) ────────────────────────────────────────────────
# testnet and mainnet are SEPARATE DEPLOYMENTS with separate keys. This selects
# which config the process loads; it is never flipped on a running engine.
CHAIN_ENV=testnet

# ── Engine key ───────────────────────────────────────────────────────────────
# Account-level xprv. Every chain's addresses derive from this one secp256k1 key
# (0/index), so one seed serves Tron and the whole EVM family. Required to boot.
CIXTECH_ENGINE_XPRV=REPLACE_ME

# ── Chains ───────────────────────────────────────────────────────────────────
# A chain is registered ONLY when its RPC URL has a value here — that is how a
# deployment enables chains, rather than by changing code. Every variable is
# listed below so this file is a full inventory; an EMPTY value means "not
# configured" and the chain is simply skipped, so you can copy this file to
# .env and fill in only the chains you want.
#
# Boot prints the result, including why each other chain was left out:
#
#   [chains] env=testnet live=TRON,BASE | not registered: BSC (no BSC_RPC_URL) …
#
# Filling in an RPC URL COMMITS you to that chain's token addresses. The engine
# refuses to start with one missing, because an unresolved contract makes
# balances read as zero — and zero is not an error downstream, it is a number
# that silently blocks payouts whose funds are sitting right there.
#
# Get token addresses from the ISSUER (Circle for USDC, Tether for USDT) or the
# chain's own bridge docs — never from a search result. Then confirm every value
# against the network itself before it sees any money:
#
#   make verify-chains
#
# which asks each RPC for its own chain id and each contract for its symbol()
# and decimals(), and exits non-zero on a mismatch.

# Tron — TRC-20. The TronGrid key is optional but strongly advised; the public
# endpoint rate-limits quickly and detection polls continuously.
# testnet: https://nile.trongrid.io   mainnet: https://api.trongrid.io
TRON_RPC_URL=
TRONGRID_API_KEY=
TRON_USDT_ADDRESS=

# ── EVM family ───────────────────────────────────────────────────────────────
# Each chain needs USDC and USDT for the CHAIN_ENV you are running: testnet and
# mainnet are DIFFERENT contracts on every chain.

# Polygon — testnet is Amoy (80002), mainnet is 137.
POLYGON_RPC_URL=
POLYGON_USDC_ADDRESS=
POLYGON_USDT_ADDRESS=

# BNB Smart Chain — testnet 97, mainnet 56.
BSC_RPC_URL=
BSC_USDC_ADDRESS=
BSC_USDT_ADDRESS=

# Arbitrum — testnet is Arbitrum Sepolia (421614), mainnet is 42161.
ARBITRUM_RPC_URL=
ARBITRUM_USDC_ADDRESS=
ARBITRUM_USDT_ADDRESS=

# Base — testnet is Base Sepolia (84532), mainnet is 8453.
BASE_RPC_URL=
BASE_USDC_ADDRESS=
BASE_USDT_ADDRESS=

# Ethereum L1 — testnet is Sepolia (11155111), mainnet is 1.
# Mind the gather economics: a payout gathers PER pool address, and L1 gas makes
# each leg an order of magnitude dearer than an L2's. Suits large tickets, not
# many small ones.
ETHEREUM_RPC_URL=
ETHEREUM_USDC_ADDRESS=
ETHEREUM_USDT_ADDRESS=

# Avalanche C-Chain — testnet is Fuji (43113), mainnet is 43114.
AVALANCHE_RPC_URL=
AVALANCHE_USDC_ADDRESS=
AVALANCHE_USDT_ADDRESS=

# Optimism — testnet is OP Sepolia (11155420), mainnet is 10.
OPTIMISM_RPC_URL=
OPTIMISM_USDC_ADDRESS=
OPTIMISM_USDT_ADDRESS=

# How far back a first-sighting EVM log scan reaches (default: 5000 blocks).
CIXTECH_EVM_LOOKBACK_BLOCKS=5000

# Reconciliation must read balances from a DIFFERENT provider than detection
# (spec §2) — one vendor being wrong in both places would make the solvency
# invariant agree with itself and prove nothing. Budget two providers per chain.
# Not yet wired; listed so provider plans are sized for it.

# ── Gas station (§6.2) ───────────────────────────────────────────────────────
# A pool address only ever receives the TOKEN, so it holds no native coin to pay
# for its own transfer. Before an ERC-20/TRC-20 payout the gather funds the
# address from this treasury.
#
# Without BOTH of these, gas funding is disabled: token payouts build and sign
# correctly, then fail at broadcast for insufficient gas. Boot says so loudly.
CIXTECH_GAS_TREASURY_ADDRESS=
CIXTECH_GAS_TREASURY_INDEX=

# ── Fee collection (§6.3) ────────────────────────────────────────────────────
# The platform's 0.5% is taken at DEPOSIT into the ledger, but the coins land in
# the merchant's pool address along with theirs. Collecting it means a real
# transfer, which normally rides along with a payout — the engine is already
# sending from those addresses, so the fee costs one extra transfer rather than a
# gather of its own. The console's "Sweep fees" button runs the same primitive
# for balances with no payout coming.
#
# One address PER CHAIN, because the transfer happens on that chain: an EVM
# address cannot receive a TRC-20. A chain with no address here simply does not
# get swept — the claim stays accrued, which is safe.
# CIXTECH_FEE_TREASURY_ADDRESS_TRON=
# CIXTECH_FEE_TREASURY_ADDRESS_POLYGON=
# CIXTECH_FEE_TREASURY_ADDRESS_BSC=
# CIXTECH_FEE_TREASURY_ADDRESS_ARBITRUM=
# CIXTECH_FEE_TREASURY_ADDRESS_BASE=
# CIXTECH_FEE_TREASURY_ADDRESS_ETHEREUM=
# CIXTECH_FEE_TREASURY_ADDRESS_AVALANCHE=
# CIXTECH_FEE_TREASURY_ADDRESS_OPTIMISM=

# Reuse the gas treasury as the fee treasury. Defensible, but it mixes operating
# float with revenue in one address and one ledger account — which is exactly the
# separation a client-asset audit wants to see. Off unless you say so.
CIXTECH_FEE_TREASURY_USES_GAS_TREASURY=false

# Below this, a residual is left where it is. A transfer costs gas; moving value
# worth less than the gas destroys money rather than collecting it.
CIXTECH_FEE_SWEEP_MIN_BASE_UNITS=100000

# How often the console's pool-address balances are refreshed (default: 2 min).
# These back a table, not a money decision — the gather and the reconciler both
# read the chain directly.
CIXTECH_POOL_BALANCE_INTERVAL_MS=120000

# ── Money-out guardrails (§7) ────────────────────────────────────────────────
# Platform fee on confirmed deposits, in basis points (default: 50 = 0.5%).
CIXTECH_FEE_BPS=50

# Largest single payout, in base units.
CIXTECH_MAX_PAYOUT=1000000000

# Rolling velocity cap.
CIXTECH_VELOCITY_WINDOW_MS=86400000
CIXTECH_VELOCITY_MAX=10000000000

# Dual control: payouts at or above the threshold are held until this many
# DISTINCT credentials approve. The requesting key can never be one of them.
#
# Issue the approver's credential with the `approve` scope ONLY, or dual control
# is two equally-privileged keys in the same vault:
#   POST /admin/api/tenants/{id}/keys  {"scopes":["approve"],"label":"approver"}
CIXTECH_APPROVAL_THRESHOLD=
CIXTECH_APPROVAL_REQUIRED=2

# Time-lock: payouts at or above the threshold wait out a delay before signing.
CIXTECH_TIMELOCK_THRESHOLD=
CIXTECH_TIMELOCK_DELAY_MS=

# HSM-held policy key that mints and verifies per-payout authorization tokens.
CIXTECH_POLICY_KEY=

# ── REQUIRED ON MAINNET ───────────────────────────────────────────────────────
# Every setting in this section is mandatory when CHAIN_ENV=mainnet: the engine
# refuses to boot without them rather than starting with a guardrail silently off
# (assertPolicyConfigured in apps/api/src/policy-config.ts). On testnet an absent
# one is logged loudly and the engine still starts.
#
# The signing key is held in the API process (ADR 0007 launch path); threshold
# MPC exists in packages/mpc but is NOT on this path. Mainnet therefore requires
# an explicit acknowledgement that a hot key is the intended posture:
CIXTECH_ACKNOWLEDGE_HOT_KEY=

# ── Webhook egress ────────────────────────────────────────────────────────────
# Tenant webhook URLs must be https and must not resolve to a loopback,
# link-local (cloud metadata) or private address — checked when the URL is set
# AND again immediately before each delivery, so DNS rebinding is covered.
# Set this only in local development; it re-opens that SSRF.
# CIXTECH_ALLOW_INSECURE_WEBHOOKS=true

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Requests per window for an authenticated tenant, the window, and the much
# tighter per-IP bucket applied to requests that FAIL authentication.
# CIXTECH_RATE_LIMIT_MAX=300
# CIXTECH_RATE_LIMIT_WINDOW_MS=60000
# CIXTECH_RATE_LIMIT_AUTH_FAILURE_MAX=20

# Serve /metrics without the admin bearer token. Only when the port is bound to
# an internal interface a scraper reaches directly.
# CIXTECH_PUBLIC_METRICS=true

# ── Admin console ────────────────────────────────────────────────────────────
# Super-admin bearer token. When unset the admin plane is disabled entirely.
CIXTECH_ADMIN_TOKEN=REPLACE_ME

# ── Redis (BullMQ worker queues) ──────────────────────────────────────────────
# Required by apps/worker for durable job processing (webhook dispatch,
# reconciliation, fee-sweep, pool release). The API falls back to setInterval
# when REDIS_URL is absent — but the worker process needs it.
REDIS_URL=redis://localhost:6380

# ── Worker configuration ──────────────────────────────────────────────────────
# How often the external reconciler runs (default: 5 minutes)
CIXTECH_RECONCILE_INTERVAL_MS=300000

# Worker health check port (default: 3001; separate from the API's port)
WORKER_PORT=3001

# Optional Docker host port overrides (if defaults conflict with existing services):
REDIS_PORT=6380
POSTGRES_PORT=5432
PORT=3000