node_modules/
dist/
coverage/
*.tsbuildinfo

# Next.js build artefacts. `out/` is the static export the image serves and
# `.next/` is the intermediate build — both are generated by `next build` and
# neither belongs in the repository.
.next/
out/
next-env.d.ts

# Emitted output belongs in dist/, never beside its source. A stray `tsc` run
# without -p once committed .js/.d.ts/.map files into the source tree, where they
# shadow the TypeScript they were built from.
backend/src/**/*.js
backend/src/**/*.js.map
backend/src/**/*.d.ts
backend/types/**/*.js
backend/types/**/*.d.ts

# frontend/src IS JavaScript — hand-written browser code, not build output — so
# the rules above must not reach it. Without this exclusion the entire console
# would look committed and be missing.
!frontend/src/**/*.js

# Secrets / env — never commit
.env
.env.*
docker.env
!.env.example
!.env.dev.example
# The ROOT .env is the exception: it holds only COMPOSE_ENV_FILES, pointing
# Compose at backend/.env. Committed so a fresh clone can `docker compose up`.
# backend/.env and frontend/.env stay ignored — this negation is anchored to the
# repository root and matches nothing below it.
!/.env
*.pem

# Test Postgres clusters (embedded, removed when the run ends)
.test-postgres/

# Dev / build scratch bundles
*.bundle.mjs
.dev-*.mjs

# MPC / key material must never touch the repo (ADR 0007)
*.share
*.keyshare
keyshares/
.whereweare

# Stale turbo cache from the previous workspace layout.
.turbo/
