node_modules/
dist/
coverage/
.turbo/
*.tsbuildinfo

# Emitted output belongs in dist/, never beside its source. A stray `tsc` run
# without -p once committed .js/.d.ts/.map files into apps/api/src, where they
# shadow the TypeScript they were built from.
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts

# Secrets / env — never commit
.env
.env.*
# `.env.*` does not match this one, and it holds a live admin token + engine xprv.
docker.env
!.env.dev.example
!.env.example
*.pem

# Test Postgres clusters (embedded, removed when the run ends)
.test-postgres/

# Dev runner / migrate scratch bundles
*.bundle.mjs

# MPC / key material must never touch the repo (ADR 0007)
*.share
*.keyshare
keyshares/
.whereweare