# Everything the image does not need. Notably node_modules: the image installs its
# own from the lockfile, and copying the host's would drop platform-specific
# binaries (esbuild, embedded-postgres) built for the wrong architecture.
node_modules
dist
coverage
.test-postgres
test
docs
scripts
tooling
Makefile
smoke.sh
*.md

# Secrets never enter the image; they arrive as runtime env.
.env
.env.*
!.env.example
!.env.dev.example
*.pem
