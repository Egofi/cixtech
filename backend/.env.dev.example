# Copy to .env.dev and `source` it before `node apps/api/dev-run.mjs`.
# Testnet-only dev config. NEVER put a mainnet key here.

# Required: network axis (separate deployments per env — never flipped live).
export CHAIN_ENV=testnet

# Required: engine account xprv (Tron account m/44'/195'/0'). Generate a fresh one:
#   node -e 'const {HDKey}=require("@scure/bip32");const {randomBytes}=require("node:crypto");console.log(HDKey.fromMasterSeed(randomBytes(32)).derive("m/44\x27/195\x27/0\x27").privateExtendedKey)'
export CIXTECH_ENGINE_XPRV=replace-me

# Required: at least one chain RPC. Tron Nile testnet is public.
export TRON_RPC_URL=https://nile.trongrid.io
export TRON_USDT_ADDRESS=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf
# export TRONGRID_API_KEY=...            # optional, avoids public-rate limits

# Admin console bearer token (ADR 0015). Omit to disable the admin plane.
export CIXTECH_ADMIN_TOKEN=dev-admin-token

# Money-out guardrails (all optional; sensible dev defaults shown).
export CIXTECH_MAX_PAYOUT=1000000000            # per-payout native-unit ceiling (§7)
export CIXTECH_VELOCITY_WINDOW_MS=86400000      # 24h rolling window
export CIXTECH_VELOCITY_MAX=10000000000
# export CIXTECH_APPROVAL_THRESHOLD=100000000   # above this, require approvals (§7.4)
# export CIXTECH_APPROVAL_REQUIRED=2
# export CIXTECH_TIMELOCK_THRESHOLD=500000000   # above this, delay signing (§7.5)
# export CIXTECH_TIMELOCK_DELAY_MS=3600000
# export CIXTECH_POLICY_KEY=dev-policy-key       # mint+verify the payout authorization token (§7)

export PORT=3000
export LOG_LEVEL=info

# ── Database (ADR 0013) ───────────────────────────────────────────────────────
# Set DATABASE_URL (or DB_URL) to run on managed Postgres — the production
# posture. It can live here or in the repo-root .env; both are loaded.
# Migrate the schema first, then start:  pnpm db:migrate && pnpm dev
#
# export DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Non-pooled endpoint for DDL. Optional, recommended on Neon: the pooled URL runs
# PgBouncer in transaction mode, which is the wrong place to run migrations.
# export DIRECT_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# TLS is verified for any non-local host. Override only for a self-signed server:
# export CIXTECH_DB_SSL=no-verify               # disable | no-verify | require
#
# A database URL is REQUIRED — there is no embedded fallback. Tests do not need
# one: they start their own real PostgreSQL (see packages/testing).
