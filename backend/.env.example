CIXTECH_EVM_LOOKBACK_BLOCKS=5000            # first-sighting log scan depth

# The address that pays the network fee for every TOKEN payout.
#
# It is NOT a wallet you create elsewhere -- it is one of this engine's own
# addresses. The engine signs from it with CIXTECH_GAS_TREASURY_INDEX, deriving
# 0/<index> from CIXTECH_ENGINE_XPRV, so the address and the index must be the
# same address or the engine signs for one and the chain is told another.
#
#   pnpm derive-address 1000000     prints it for every family
#
# Pick an index pool addresses will never reach: they are allocated from 0 upward
# per chain, and a collision would hand a merchant the gas treasury as a deposit
# address. Then fund it with native gas (TRX / POL / ETH) from a faucet.
#
# One line per chain -- the same key is a `T...` address on Tron and an `0x...`
# address on EVM, so a single value cannot serve both. The bare
# CIXTECH_GAS_TREASURY_ADDRESS is the fallback for a single-family deployment.
CIXTECH_GAS_TREASURY_INDEX=
CIXTECH_GAS_TREASURY_ADDRESS=
#CIXTECH_GAS_TREASURY_ADDRESS_TRON=
#CIXTECH_GAS_TREASURY_ADDRESS_POLYGON=
#CIXTECH_GAS_TREASURY_ADDRESS_ETHEREUM=

CIXTECH_FEE_BPS=50                          # 0.5% taken at deposit
CIXTECH_FEE_SWEEP_MIN_BASE_UNITS=1000000    # below this, leave it rather than pay gas
CIXTECH_FEE_TREASURY_USES_GAS_TREASURY=false

CIXTECH_MAX_PAYOUT=1000000000               # largest single payout, base units
CIXTECH_VELOCITY_WINDOW_MS=86400000
CIXTECH_VELOCITY_MAX=10000000000
CIXTECH_APPROVAL_THRESHOLD=100000000        # above this, held for approval
CIXTECH_APPROVAL_REQUIRED=2                 # distinct keys; requester never counts
CIXTECH_TIMELOCK_THRESHOLD=500000000
CIXTECH_TIMELOCK_DELAY_MS=3600000
CIXTECH_ACKNOWLEDGE_HOT_KEY=false           # must be true to boot mainnet

# Leave both EMPTY to use the console proxy (the default topology).
#
# The consoles then build relative URLs, every call goes to the console origin,
# and nginx forwards /v1, /auth, /admin/api and /docs to the API. The API has no
# address the browser ever sees, there is no preflight, and the session cookie is
# SameSite=Lax. docker-compose.yml sets these on the containers regardless, so a
# stale value here cannot quietly defeat the proxy.
#
# Set them ONLY to go back to the browser calling the API directly:
#   CIXTECH_API_BASE      where the BROWSER reaches the API, e.g. https://api.example.com
#   CIXTECH_CORS_ORIGINS  console origins allowed to call it (exact match, no wildcard)
CIXTECH_API_BASE=
CIXTECH_CORS_ORIGINS=

# Believe X-Forwarded-For when deriving req.ip. Only safe when the API cannot be
# reached except through the proxy -- otherwise a direct caller forges it and the
# per-IP limit on failed credentials stops counting (SECURITY_AUDIT CX-08).
# Compose manages this per topology; set it by hand only outside compose.
CIXTECH_TRUST_PROXY=false

CIXTECH_DETECTION_INTERVAL_MS=15000
CIXTECH_RECONCILE_INTERVAL_MS=300000
CIXTECH_POOL_BALANCE_INTERVAL_MS=120000
