# cixtech backend — copy to .env and fill in every REPLACE_ME.
#
# The chain RPC URLs and token contracts below were verified against their
# networks with `pnpm verify:chains`. Re-run it after any change, and before
# any of it sees value.

# ── Database 
DATABASE_URL=postgresql://cixtech_owner:REPLACE_ME@127.0.0.1:5432/cixtech
DIRECT_DATABASE_URL=postgresql://cixtech_owner:REPLACE_ME@127.0.0.1:5432/cixtech
CIXTECH_DB_SSL=disable                      # local Postgres serves no TLS
CIXTECH_APP_ROLE=cixtech_app

# ── Compose 
POSTGRES_USER=cixtech_owner
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=cixtech
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6380
PORT=3000
WORKER_PORT=3001
LOG_LEVEL=info

# ── Keys 
CHAIN_ENV=testnet                           # testnet and mainnet are separate deployments
CIXTECH_ENGINE_XPRV=REPLACE_ME            # pnpm generate-test-key
CIXTECH_ADMIN_TOKEN=REPLACE_ME            # bootstrap only; pnpm rotate-admin-token
CIXTECH_POLICY_KEY=REPLACE_ME            # openssl rand -hex 32

# ── Chains 
# A chain registers only if its RPC URL has a value, and then ALL its token
# addresses are required — a missing one refuses the boot.
# Every value below was verified against the network: `pnpm verify:chains`.

# Tron Nile
TRON_RPC_URL=https://nile.trongrid.io
TRON_USDT_ADDRESS=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf
TRONGRID_API_KEY=

# Polygon Amoy (80002)
POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
POLYGON_USDC_ADDRESS=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582
POLYGON_USDT_ADDRESS=0x1616d425Cd540B256475cBfb604586C8598eC0FB

# Ethereum Sepolia (11155111)
ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
ETHEREUM_USDT_ADDRESS=0xaA8E23Fb1079EA71e0a56F48a2aA51851D8433D0

# ── Chains verified but NOT enabled ──────────────────────────────────────────
# RPC and USDC confirmed on-chain; each needs a USDT address before it can boot.
# Uncomment the RPC line only once its USDT is filled in and verified.

# BSC testnet (97) — USDT here is 18 decimals, the registry declares 6. Do not
# enable until that is reconciled, or every BSC balance is wrong by 10^12.
# BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_USDC_ADDRESS=
BSC_USDT_ADDRESS=

# Arbitrum Sepolia (421614)
# ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_USDC_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
ARBITRUM_USDT_ADDRESS=

# Base Sepolia (84532)
# BASE_RPC_URL=https://sepolia.base.org
BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_USDT_ADDRESS=

# Avalanche Fuji (43113)
# AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
AVALANCHE_USDT_ADDRESS=

# OP Sepolia (11155420)
# OPTIMISM_RPC_URL=https://sepolia.optimism.io
OPTIMISM_USDC_ADDRESS=0x5fd84259d66Cd46123540766Be93DFE6D43130D7
OPTIMISM_USDT_ADDRESS=

CIXTECH_EVM_LOOKBACK_BLOCKS=5000            # first-sighting log scan depth

# ── Gas station
# Both required, or token payouts sign then fail at broadcast for no gas.
CIXTECH_GAS_TREASURY_ADDRESS=
CIXTECH_GAS_TREASURY_INDEX=

# ── Fees 
CIXTECH_FEE_BPS=50                          # 0.5% taken at deposit
CIXTECH_FEE_SWEEP_MIN_BASE_UNITS=1000000    # below this, leave it rather than pay gas
CIXTECH_FEE_TREASURY_USES_GAS_TREASURY=false
# CIXTECH_FEE_TREASURY_ADDRESS_TRON=        # one per chain; unset = never swept

# ── Money-out guardrails
CIXTECH_MAX_PAYOUT=1000000000               # largest single payout, base units
CIXTECH_VELOCITY_WINDOW_MS=86400000
CIXTECH_VELOCITY_MAX=10000000000
CIXTECH_APPROVAL_THRESHOLD=100000000        # above this, held for approval
CIXTECH_APPROVAL_REQUIRED=2                 # distinct keys; requester never counts
CIXTECH_TIMELOCK_THRESHOLD=500000000
CIXTECH_TIMELOCK_DELAY_MS=3600000
CIXTECH_ACKNOWLEDGE_HOT_KEY=false           # must be true to boot mainnet

# ── Consoles
CIXTECH_API_BASE=http://localhost:3000      # where the BROWSER reaches the API
CIXTECH_CORS_ORIGINS=http://localhost:8080  # origins allowed to call it

# ── Worker
CIXTECH_DETECTION_INTERVAL_MS=15000
CIXTECH_RECONCILE_INTERVAL_MS=300000
CIXTECH_POOL_BALANCE_INTERVAL_MS=120000
