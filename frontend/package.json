{
  "name": "@cixtech/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "cixtech consoles — admin control plane and tenant portal (Next.js, static export)",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "npx serve@latest out -l 8080",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "lint:ci": "biome check .",
    "test": "next build && node verify.mjs",
    "check": "pnpm typecheck && pnpm lint:ci && pnpm test"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.7.3"
  }
}
